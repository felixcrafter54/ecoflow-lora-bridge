# =====================================================================
#  Gemeinsam
# =====================================================================
# Lokaler Index des gemeinsamen Kanals AUF DIESEM NODE.
# Achtung: Der Index ist pro Gerät verschieden, je nachdem in welcher
# Reihenfolge die Kanäle angelegt wurden. Massgeblich ist der PSK,
# nicht die Nummer. Prüfen mit: meshtastic --port ... --info
# Nur fuers SENDEN relevant. Eingehende Pakete werden nach Absender
# gefiltert, nicht nach Kanal: PKI-Direktnachrichten melden auf der
# Empfangsseite nicht den erwarteten Index.
MESH_CHANNEL_INDEX=1
MESH_CHANNEL_INDEX=1

# Node-ID der Gegenstelle, hex oder dezimal. Ausrufezeichen weglassen.
# Auf dem Pi steht hier der Haus-Node, im Gateway der Garagen-Node.
PEER_NODE_ID=0x00000000

# Serieller Port des angeschlossenen Meshtastic-Nodes.
# Immer den by-id-Pfad nehmen, nie /dev/ttyACM0.
MESH_PORT=/dev/serial/by-id/usb-CHANGE_ME

# =====================================================================
#  Nur Garage (bridge.py)
# =====================================================================
EF_MAC=AA:BB:CC:DD:EE:FF
EF_USER_ID=

DB_PATH=/mnt/ssd/ecoflow.db
RETENTION_DAYS=0          # 0 = Rohdaten nie löschen

MIN_GAP=60                # kürzester Abstand zwischen zwei Paketen (s)
HEARTBEAT=300             # spätestens nach so vielen Sekunden senden
SHUTDOWN_SOC=0            # 0 = aus. Sonst z.B. 10 (%)
SHUTDOWN_HOLD=300         # so lange unter der Schwelle, bevor abgeschaltet wird

# =====================================================================
#  Nur Haus (gateway.py)
# =====================================================================
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_BASE=ecoflow
EXPIRE_AFTER=1800         # danach werden HA-Entitäten "unavailable"
