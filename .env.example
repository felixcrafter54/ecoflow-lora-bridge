# --- EcoFlow ---
EF_MAC=AA:BB:CC:DD:EE:FF
EF_USER_ID=

# --- Meshtastic ---
MESH_PORT=/dev/serial/by-id/usb-CHANGE_ME
MESH_CHANNEL_INDEX=1
MESH_CHANNEL_NAME=ecoflow
PEER_NODE_ID=0x00000000

# --- Sendelogik ---
MIN_GAP=60
HEARTBEAT=300
SHUTDOWN_SOC=10

# --- Speicher ---
DB_PATH=/mnt/ssd/ecoflow.db
